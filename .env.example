APP_NAME="Oasis CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_VERSION=
APP_COMMIT_SHA=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Hostinger MySQL Database ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- SMTP (Hostinger Mail) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="your@email.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Google Script Integration ---
GOOGLE_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxbZZsLrCO7tSst0NfsT8mYB_jBfN8TnWlK7ceIAWKu9ZFOa8bCkZKO4qa1DkpDR8qs/exec
GOOGLE_SCRIPT_TIMEOUT=30
GOOGLE_SCRIPT_VERIFY_SSL=false

# --- Google Sheets API Sync ---
GOOGLE_SHEETS_CREDENTIALS_PATH=storage/app/google/service-account.json
GOOGLE_SHEETS_CACHE_STALE_MINUTES=30
GOOGLE_SHEETS_VERIFY_SSL=false
DANA_TALANGAN_SHEET_ID=1A7ISvfvvuDr5u9qAsNfi_CSehKNu7nwvJCaVWDU4jjM
DANA_TALANGAN_SHEET_NAME=Talangan

# --- Collaboration Presence ---
PRESENCE_ENABLED=true
PRESENCE_HEARTBEAT_SECONDS=25
PRESENCE_OFFLINE_SECONDS=60
PRESENCE_CLEANUP_HOURS=24
NOTIFICATION_POLLING_ENABLED=true
NOTIFICATION_READ_RETENTION_DAYS=180

# Rotate the legacy webhook before enabling this optional integration.
FEEDBACK_DISCORD_ENABLED=false
FEEDBACK_DISCORD_WEBHOOK_URL=
FEEDBACK_DISCORD_INCLUDE_USER_EMAIL=false
FEEDBACK_DISCORD_INCLUDE_IP=false

# --- Oasis AI Chat (OpenAI-compatible: OpenRouter, NVIDIA NIM, Ollama) ---
AI_CHAT_ENABLED=true
AI_CHAT_TIMEOUT=30
AI_CHAT_MAX_MESSAGES=12
AI_CHAT_MAX_INPUT_LENGTH=1000
AI_PRIMARY_PROVIDER=nvidia
AI_PRIMARY_BASE_URL=https://integrate.api.nvidia.com/v1
AI_PRIMARY_KEY=
AI_PRIMARY_MODEL=meta/llama-3.1-8b-instruct

AI_FALLBACK_PROVIDER=openrouter
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_KEY=
AI_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free

VITE_APP_NAME="${APP_NAME}"
